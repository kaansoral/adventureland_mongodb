    },
    "linux": {
      "appimage": {
        "files": {
          "usr/lib/libsteam_api.so": "binaries/libsteam_api.so"
        }
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {}
  }
