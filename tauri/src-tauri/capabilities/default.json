{
  "$schema": "https://schemas.tauri.app/config/v2/capability.json",
  "identifier": "default",
  "description": "Default capability for all Adventure Land windows",
  "windows": ["main", "sub-*", "loader"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "shell:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "store:allow-get",
    "store:allow-set",
    "store:allow-load",
    "store:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-create-dir",
    "fs:allow-read-dir"
  ]
}
